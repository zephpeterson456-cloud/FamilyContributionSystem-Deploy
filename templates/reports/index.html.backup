{% extends "base.html" %}

{% block title %}Reports{% endblock %}

{% block content %}

<div class="container mt-4">

    <h2>Reports</h2>

    <div class="row mb-4">

        <div class="col-md-3">
            <div class="card text-center shadow">
                <div class="card-body">
                    <h3>{{ contributors }}</h3>
                    <p>Contributors</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-center shadow">
                <div class="card-body">
                    <h3>{{ beneficiaries }}</h3>
                    <p>Beneficiaries</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-center shadow">
                <div class="card-body">
                    <h3>{{ families }}</h3>
                    <p>Families</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-center shadow">
                <div class="card-body">
                    <h3>KES {{ total_collections }}</h3>
                    <p>Total Collections</p>
                </div>
            </div>
        </div>

    </div>

    <div class="card shadow">

        <div class="card-header">
            Recent Payments
        </div>

        <div class="card-body">

            <table class="table table-striped">

                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Contributor</th>
                        <th>Amount</th>
                        <th>Method</th>
                    </tr>
                </thead>

                <tbody>

                {% for payment in payments %}

                <tr>
                    <td>{{ payment.payment_date }}</td>
                    <td>{{ payment.contributor.full_name }}</td>
                    <td>KES {{ payment.amount }}</td>
                    <td>{{ payment.payment_method }}</td>
                </tr>

                {% empty %}

                <tr>
                    <td colspan="4">
                        No payments recorded.
                    </td>
                </tr>

                {% endfor %}

                </tbody>

            </table>

        </div>

    </div>

</div>

{% endblock %}
